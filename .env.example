# ==============================================================================
# Chat Ideal Plastic Surgery — Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# IMPORTANTE:
# 1. Copia este archivo como `.env.local` para desarrollo local.
# 2. NUNCA subas `.env` ni `.env.local` al repositorio Git.
# 3. NUNCA expongas claves secretas bajo el prefijo `NEXT_PUBLIC_`.
# 4. En esta versión v1 NO se utiliza Inteligencia Artificial (sin OpenAI ni LLMs).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL pública de la aplicación (Next.js / Vercel)
# ------------------------------------------------------------------------------
# En local: http://localhost:3000
# En producción: https://chat.tudominio.com (o el dominio asignado en Vercel)
NEXT_PUBLIC_APP_URL=

# ------------------------------------------------------------------------------
# 2. Supabase — Claves públicas (seguras para navegador, sujetas siempre a RLS)
# ------------------------------------------------------------------------------
# Obtener en Supabase Dashboard -> Connect / Settings -> API Keys
# Nota: Usa la nueva Publishable Key (`sb_publishable_...`) recomendada por Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 3. Supabase — Claves exclusivas de servidor (NUNCA usar prefijo NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# ADVERTENCIA CRÍTICA: `SUPABASE_SECRET_KEY` (`sb_secret_...`) omite RLS (BYPASSRLS).
# Solo puede leerse desde el backend en `src/lib/supabase/admin.ts` (protegido con `server-only`).
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 4. Seguridad de sesiones anónimas del Widget e integración CORS / CSP
# ------------------------------------------------------------------------------
# Secreto HMAC de alta entropía (>= 32 caracteres aleatorios, ej. `openssl rand -hex 32`)
# para firmar/verificar sesiones opacas de visitantes en servidor.
VISITOR_SESSION_HMAC_SECRET=

# Lista separada por comas de orígenes HTTPS autorizados para embeber `/widget`
# (WordPress / Framer) y comunicarse vía postMessage.
# Ejemplo: https://idealplasticsurgery.com,https://www.idealplasticsurgery.com
WIDGET_ALLOWED_ORIGINS=
